// Stable, creation-order display codes for Archive folders/items (e.g.
// "1.2F" for the 2nd subfolder of root folder 1, "1.2F.3" for the 3rd item
// in it) — ported from the otman-archive prototype's SectionItem.code
// scheme. Lives in OTman's own schema, not the @customprojects/custom-archive
// package's, because that package's ArchiveFolder/ArchiveItem tables have no
// room for a host-defined field and we don't own that migration history.
// folderId/itemId are opaque references to rows in the archive package's own
// database (cross-database, not a Prisma relation) — see
// lib/docArchive/folderCodes.ts for the assignment/lookup logic.
//
// Each row's localSeq is assigned once, atomically, via
// ArchiveSequenceCounter, and never reassigned — deleting a sibling never
// renumbers the ones around it, since nothing here is derived from current
// list position.
model ArchiveFolderCode {
  id        String          @id @default(cuid())
  companyId String
  tenantId  String
  folderId  String          @unique
  localSeq  Int
  sectionId String?
  section   ArchiveSection? @relation(fields: [sectionId], references: [id])
  createdAt DateTime        @default(now())

  @@index([companyId, tenantId])
  @@index([sectionId])
}

model ArchiveItemCode {
  id        String          @id @default(cuid())
  companyId String
  tenantId  String
  itemId    String          @unique
  localSeq  Int
  sectionId String?
  section   ArchiveSection? @relation(fields: [sectionId], references: [id])
  createdAt DateTime        @default(now())

  @@index([companyId, tenantId])
  @@index([sectionId])
}

// Records which two @customprojects/custom-archive ArchiveRole ids are this
// tenant's durable system roles ("Admin", "Viewer") — one row per company.
// The package has no concept of "the" role for a purpose; roles are just
// arbitrary named subject groups (see ArchiveRolesPanel.tsx's user-facing
// "folder-sharing groups"). These two are created once per tenant (see
// lib/docArchive/tenantRoles.ts) and every company member with ARCHIVE
// module access is kept assigned to the matching one (lib/docArchive/
// roleSync.ts), giving Admins edit and Viewers view access everywhere by
// default via a role-based allow grant on every root folder — folder owners
// override per-folder by adding a local deny for a specific person. Without
// this table there'd be no reliable way to tell these two apart from a
// user-created sharing group of the same name in listArchiveRoles' results.
model ArchiveTenantRoles {
  id           String   @id @default(cuid())
  companyId    String   @unique
  tenantId     String
  adminRoleId  String
  viewerRoleId String
  createdAt    DateTime @default(now())
}

// Host-side grouping layer within a folder's settings (or the archive
// root) — the @customprojects/custom-archive package's own folder/item
// model has no concept of sections, so this lives in OTman's schema like
// ArchiveFolderCode/ArchiveItemCode above. `parentFolderId` is the same
// ROOT_SCOPE sentinel used by ArchiveSequenceCounter for root-level
// sections, else the containing folder's id (opaque cross-database
// reference, not a Prisma relation — see lib/docArchive/folderCodes.ts).
// Folders/items reference their section via ArchiveFolderCode.sectionId /
// ArchiveItemCode.sectionId, nullable so pre-existing rows created before
// this feature can stay "ungrouped" rather than requiring a data backfill;
// new subfolders/items are required (at the API layer) to specify one.
model ArchiveSection {
  id             String              @id @default(cuid())
  companyId      String
  tenantId       String
  parentFolderId String
  name           String
  description    String?
  order          Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  folderCodes    ArchiveFolderCode[]
  itemCodes      ArchiveItemCode[]

  @@index([companyId, tenantId, parentFolderId])
}

enum ArchiveSequenceScope {
  FOLDER
  ITEM
}

// Reminder-specific description, separate from the folder/item's own
// `description` field (which lives in the archive package's own schema). A
// row only exists when a reminder description has been explicitly set;
// clearing it deletes the row rather than storing an empty string.
// recurrenceType/recurrenceConfig mirror RecurringOrderTemplate's own fields
// (same RecurrenceType enum, same config shapes per
// lib/orders/recurringOrders/occurrenceDates.ts) — both nullable here since,
// unlike a scheduler order template, a reminder is allowed to have no
// recurrence at all (a plain one-off due date).
model ArchiveFolderReminderNote {
  id               String          @id @default(cuid())
  companyId        String
  tenantId         String
  folderId         String          @unique
  description      String
  recurrenceType   RecurrenceType?
  recurrenceConfig Json?
  updatedAt        DateTime        @updatedAt

  @@index([companyId, tenantId])
}

model ArchiveItemReminderNote {
  id               String          @id @default(cuid())
  companyId        String
  tenantId         String
  itemId           String          @unique
  description      String
  recurrenceType   RecurrenceType?
  recurrenceConfig Json?
  updatedAt        DateTime        @updatedAt

  @@index([companyId, tenantId])
}

enum ArchiveReminderEntityKind {
  ITEM
  FOLDER
}

enum ArchiveReminderOccurrenceStatus {
  PENDING
  DONE
  SNOOZED
}

// Per-occurrence backlog for a recurring reminder — ArchiveFolderReminderNote/
// ArchiveItemReminderNote above only store the recurrence *rule*; the archive
// entity itself only has one `dueAt`, so neither can represent "missed 3 of
// the last 5 matching days." This table materializes individual matching
// dates within a bounded window (see lib/docArchive/reminderOccurrences.ts)
// so the dashboard Reminders widget can show/act on them one at a time,
// independent of the entity's own single dueAt (which keeps being advanced by
// the older, deliberately stateless lib/docArchive/reminderRecurrence.ts cron
// for browse-page badges — the two are intentionally allowed to diverge, see
// that file's own comment on why it stays stateless). occurrenceDate is a
// "YYYY-MM-DD" key, immutable identity for the row (never renamed on
// snooze) — snoozing sets snoozedUntil instead, which is what read queries
// and display should treat as the row's effective date once set.
model ArchiveReminderOccurrence {
  id             String                          @id @default(cuid())
  companyId      String
  tenantId       String
  entityKind     ArchiveReminderEntityKind
  entityId       String
  occurrenceDate String
  status         ArchiveReminderOccurrenceStatus @default(PENDING)
  snoozedUntil   String?
  resolvedAt     DateTime?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt

  @@unique([entityKind, entityId, occurrenceDate])
  @@index([companyId, status, occurrenceDate])
  @@index([entityKind, entityId, status])
}

enum ArchiveContentSectionType {
  IMAGES
  FILES
  TEXT_FIELDS
  SPREADSHEET
  TITLE
  YOUTUBE
}

// An item's "Content" area (Images/Files/Text fields) is broken into
// reorderable section instances — same repositioning approach as
// BlogSection/sectionPositions.ts (see lib/docArchive/contentSections.ts): a
// unique (itemId, position) pair, repositioned via a two-phase temp-offset
// update so a reorder never collides with the unique index mid-transaction.
// An item can hold any number of sections of the same type (e.g. two
// separate "Images" galleries), unlike ArchiveItemReminderNote's one-per-item
// cap — each section instance scopes its own slice of content via
// ArchiveItemTextField.sectionId / ArchiveItemFileSection below.
//
// IMAGES/FILES sections are soft-deleted (deletedAt set, position cleared to
// null) rather than hard-deleted, specifically so a later per-file restore
// (see lib/docArchive/contentSections.ts's deleteContentSection/
// reviveSectionForFileIfDeleted) can revive the EXACT original section a
// restored file belonged to, instead of re-bucketing it into an unrelated
// section. `position` has to be nullable for this: Postgres unique
// constraints treat every NULL as distinct, so clearing a deleted section's
// position frees its (itemId, position) slot for reuse by the remaining
// active sections without a collision, while still enforcing uniqueness
// among the never-null ACTIVE rows. TEXT_FIELDS sections are unaffected —
// they have no file content to restore, so they're still hard-deleted (see
// deleteContentSection).
model ArchiveItemContentSection {
  id          String                    @id @default(cuid())
  companyId   String
  tenantId    String
  itemId      String
  type        ArchiveContentSectionType
  position    Int?
  deletedAt   DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  textFields   ArchiveItemTextField[]
  fileLinks    ArchiveItemFileSection[]
  spreadsheet  ArchiveItemSpreadsheet?
  title        ArchiveItemTitle?
  youtubeEmbed ArchiveItemYoutubeEmbed?

  @@unique([itemId, position])
  @@index([companyId, tenantId, itemId])
}

// Host-side "text field" item content, alongside the archive package's own
// file storage — same reasoning as ArchiveItemReminderNote: the package has
// no structured-content storage at all (see
// docs/documentation/integrations/archive-ui-known-gaps.md), so this lives
// in OTman's schema, keyed by the package's opaque itemId (cross-database
// reference, not a Prisma relation). Unlike ArchiveItemReminderNote, an item
// can have any number of these (each a user-labelled field), so itemId is
// not unique — order is assigned like ArchiveSection.order, append-only by
// default. sectionId scopes a field to one specific Text-fields section
// instance (a real Prisma relation — both models live in this same schema);
// deleting a section cascades to the fields inside it, same as deleting a
// BlogSection deletes its own data.
model ArchiveItemTextField {
  id        String                    @id @default(cuid())
  companyId String
  tenantId  String
  itemId    String
  sectionId String
  section   ArchiveItemContentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label     String
  value     String
  order     Int                       @default(0)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([companyId, tenantId, itemId])
  @@index([sectionId])
}

// Host-side mapping from an opaque archive-package fileId to the Images/
// Files section instance it's displayed under — the package itself has no
// concept of sections, so a file's section membership lives here instead of
// on the file row. fileId is unique: a file belongs to at most one section.
// Deleting the section only removes this mapping (the underlying file is
// untouched); a file left without a mapping is lazily re-bucketed into the
// item's next matching-type section on read — see
// lib/docArchive/contentSections.ts's assignOrphanFiles.
model ArchiveItemFileSection {
  id        String                    @id @default(cuid())
  companyId String
  tenantId  String
  fileId    String                    @unique
  sectionId String
  section   ArchiveItemContentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt DateTime                  @default(now())

  @@index([companyId, tenantId, sectionId])
}

// Host-side "description" text for an individual uploaded file, same
// reasoning as ArchiveItemFileSection: the archive package's own file record
// has no free-text field for the uploader to explain what's inside before
// someone downloads it, so it lives here instead, keyed by the package's
// opaque fileId (cross-database reference, not a Prisma relation). fileId is
// unique: at most one description per file. A file with no row here simply
// has no description yet — there's no separate "empty description" state,
// the row is deleted instead of holding an empty string (see
// lib/docArchive/fileDescriptions.ts).
model ArchiveFileDescription {
  id          String   @id @default(cuid())
  companyId   String
  tenantId    String
  fileId      String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, tenantId])
}

// Host-side "spreadsheet" item content, same reasoning as
// ArchiveItemTextField: the package has no tabular/structured-data storage
// (see docs/documentation/integrations/archive-ui-known-gaps.md), so the
// whole grid lives here as one JSON document rather than normalized
// row/column/cell rows — it's always read and saved as a unit (see
// SpreadsheetPanel's manual-save flow), so a normalized schema would only
// add join complexity with no benefit. One row per Spreadsheet section
// instance (sectionId unique), cascade-deleted with its section.
model ArchiveItemSpreadsheet {
  id        String                    @id @default(cuid())
  companyId String
  tenantId  String
  itemId    String
  sectionId String                    @unique
  section   ArchiveItemContentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([companyId, tenantId, itemId])
}

// Host-side "title" item content, same reasoning as ArchiveItemSpreadsheet:
// the package has no structured-content storage (see
// docs/documentation/integrations/archive-ui-known-gaps.md). A single plain-
// text heading, kept separate from ArchiveItemTextField (which is a list of
// labeled rich-text fields) — a Title section is just one short line, always
// rendered large, with no label of its own. One row per Title section
// instance (sectionId unique), cascade-deleted with its section, and
// provisioned lazily on first read like ArchiveItemSpreadsheet.
model ArchiveItemTitle {
  id        String                    @id @default(cuid())
  companyId String
  tenantId  String
  itemId    String
  sectionId String                    @unique
  section   ArchiveItemContentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([companyId, tenantId, itemId])
}

// Host-side "YouTube embed" item content, same reasoning as
// ArchiveItemTitle: the package has no structured-content storage (see
// docs/documentation/integrations/archive-ui-known-gaps.md). Stores the raw
// URL the user pasted (any accepted YouTube URL shape — watch/youtu.be/
// embed/shorts), not a pre-parsed video id, so the settings panel's input
// round-trips exactly what was typed; the video id is re-derived from `url`
// via extractYoutubeVideoId at render time on both the settings preview and
// the read-only view, same "store raw, sanitize/derive at render" shape as
// ArchiveItemTitle's HTML. One row per YouTube section instance (sectionId
// unique), cascade-deleted with its section, provisioned lazily on first
// read like ArchiveItemTitle/ArchiveItemSpreadsheet.
model ArchiveItemYoutubeEmbed {
  id        String                    @id @default(cuid())
  companyId String
  tenantId  String
  itemId    String
  sectionId String                    @unique
  section   ArchiveItemContentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  url       String
  // Optional short plain-text caption rendered directly above the embed —
  // deliberately not rich text (unlike ArchiveItemTitle): this is meant as
  // a quick "what is this video" label for the one video in this section,
  // not a standalone formattable heading, so no RichTextEditorField/
  // sanitizeBlogHtml round-trip like ArchiveItemTitle.text needs.
  title     String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([companyId, tenantId, itemId])
}

// One row per (parent scope, FOLDER-or-ITEM counter); parentFolderId is the
// sentinel below for the tenant root scope (root folders have no parent, but
// a NULL column wouldn't enforce the one-row-per-scope @@unique below, since
// Postgres treats every NULL as distinct).
model ArchiveSequenceCounter {
  id             String               @id @default(cuid())
  companyId      String
  tenantId       String
  parentFolderId String
  scope          ArchiveSequenceScope
  nextSeq        Int                  @default(1)
  updatedAt      DateTime             @updatedAt

  @@unique([companyId, tenantId, parentFolderId, scope])
}
