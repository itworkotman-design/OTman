model BlogPost {
  id     String         @id @default(cuid())
  slug   String         @unique
  status BlogPostStatus @default(DRAFT)

  title          Json
  excerpt        Json
  seoTitle       Json?
  seoDescription Json?
  noIndex        Boolean @default(false)

  coverImagePath     String?
  coverImageAlt      Json?
  // Vertical focal point for the cover image crop, 0 (top) - 100 (bottom),
  // applied as `object-position: center Y%` wherever the image is rendered
  // with object-fit: cover — a percentage (not a fixed px value) so the same
  // stored position stays correct across the different container heights
  // BlogListCard/BlogImagePicker/etc. each render it at.
  coverImagePosition Int?    @default(50)

  authorId          String?
  authorDisplayName String?

  isPinned    Boolean   @default(false)
  pinnedAt    DateTime?
  publishedAt DateTime?
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sections BlogSection[]
  tags     BlogPostTag[]

  @@index([status, isPinned, pinnedAt, createdAt])
  @@index([status, publishedAt])
  @@index([authorId])
}

